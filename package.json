{
  "name": "nooklings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run assets && npm run dev -w @nooklings/client",
    "build": "npm run assets && npm run build -w @nooklings/client",
    "preview": "npm run preview -w @nooklings/client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets": "node tools/build-asset-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
