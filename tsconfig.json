{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@nooklings/core": ["packages/core/src/index.ts"],
      "@nooklings/content": ["packages/content/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/client/src", "apps/client/vite.config.ts", "vitest.config.ts"]
}
